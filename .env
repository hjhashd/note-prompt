# --- 应用基础配置 ---
# 生产环境服务端口
APP_PORT=10086
# 开发环境服务端口
DEV_PORT=5173

# --- 后端服务配置 ---
# 注意：在 Docker 网络内部，通常使用服务名作为 Host

# Python 后端端口
PYTHON_PORT=12543
# Java 后端端口
JAVA_PORT=18081

# --- API 地址配置 (用于 Nginx 反向代理) ---
# 模式 A: 容器间通信 (后端也在 Docker 中运行，且服务名为 python-backend/java-backend)
# PYTHON_API_URL=http://python-backend:12543
# JAVA_API_URL=http://java-backend:18081

# 模式 B: 宿主机通信 (后端直接运行在服务器上，非容器化)
# 方式 1: 使用 host.docker.internal (推荐，Docker 会自动解析为宿主机 IP)
PYTHON_API_URL=http://192.168.3.10:34521
JAVA_API_URL=http://192.168.3.10:18081

# 方式 2: 直接指定宿主机内网 IP (如果方式 1 在某些 Linux 版本失效)
# PYTHON_API_URL=http://172.17.0.1:34521
# JAVA_API_URL=http://172.17.0.1:18081
